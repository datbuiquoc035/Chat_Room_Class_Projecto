</style>

@code {
    [Parameter] public string? RoomId { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? UserId { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? Username { get; set; }

    // Sidebar state
    private List<ChatApp.Frontend.Services.Room> rooms = new();
    private string searchQuery = "";
    private bool isCreatingRoom = false;
    private string newRoomName = "";
    private string? sidebarRateLimitAlert;

    // Chat room state
    private List<ChatApp.Frontend.Services.Message> messages = new();
    private ChatApp.Frontend.Services.Room? roomInfo;
    private string currentMessage = "";
    private string? chatRateLimitAlert;
    private bool isWsConnected = false;
    private bool isLoadingRoom = false;
    private ClientWebSocket? ws;
    private CancellationTokenSource cts = new();

    private string? _activeLoadedRoomId;

    private List<ChatApp.Frontend.Services.Room> FilteredRooms =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? rooms
            : rooms.Where(r => r.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                               r.Id.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(UserId))
        {
            UserId = "user_1";
            Username = "user1";
        }
        await LoadRooms();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(UserId))
        {
            UserId = "user_1";
            Username = "user1";
        }

        if (!string.IsNullOrEmpty(RoomId) && _activeLoadedRoomId != RoomId)
        {
            await SwitchToRoom(RoomId);
        }
    }

    private async Task LoadRooms(bool force = false)
    {
        try
        {
            rooms = await ChatService.GetRoomsAsync(UserId, force);
            sidebarRateLimitAlert = null;
        }
        catch (ChatApp.Frontend.Services.RateLimitException ex)
        {
            sidebarRateLimitAlert = ex.Message;
        }
        catch { }
    }

    private async Task SelectRoom(string roomId)
    {
        if (RoomId == roomId) return;
        RoomId = roomId;
        Navigation.NavigateTo($"/chat/{roomId}?userId={UserId}&username={Username}", false);
        await SwitchToRoom(roomId);
    }

    private async Task SwitchToRoom(string roomId)
    {
        _activeLoadedRoomId = roomId;
        isLoadingRoom = true;
        chatRateLimitAlert = null;
        messages.Clear();
        roomInfo = null;

        // Cancel previous WebSocket
        cts.Cancel();
        if (ws != null)
        {
            try { ws.Dispose(); } catch { }
            ws = null;
        }
        cts = new CancellationTokenSource();
        isWsConnected = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            roomInfo = await ChatService.GetRoomAsync(roomId, UserId);
            messages = await ChatService.GetMessagesAsync(roomId, UserId);
            await ChatService.JoinRoomAsync(roomId, UserId ?? "user_1", Username ?? "user1");
        }
        catch (ChatApp.Frontend.Services.RateLimitException ex)
        {
            chatRateLimitAlert = ex.Message;
        }
        catch (Exception ex)
        {
            chatRateLimitAlert = ex.Message;
        }

        isLoadingRoom = false;
        await InvokeAsync(StateHasChanged);

        // Start WebSocket listener in background
        _ = ConnectWebSocketAsync(roomId, cts.Token);
    }

    private void CloseRoom()
    {
        RoomId = null;
        _activeLoadedRoomId = null;
        cts.Cancel();
        if (ws != null)
        {
            try { ws.Dispose(); } catch { }
            ws = null;
        }
        Navigation.NavigateTo($"/lobby?userId={UserId}&username={Username}", false);
    }

    private async Task ConnectWebSocketAsync(string roomId, CancellationToken token)
    {
        while (!token.IsCancellationRequested && _activeLoadedRoomId == roomId)
        {
            try
            {
                ws = new ClientWebSocket();
                await ws.ConnectAsync(new Uri($"ws://127.0.0.1:8000/ws/rooms/{roomId}"), token);
                isWsConnected = true;
                await InvokeAsync(StateHasChanged);

                var buffer = new byte[1024 * 8];
                while (ws.State == WebSocketState.Open && !token.IsCancellationRequested && _activeLoadedRoomId == roomId)
                {
                    var result = await ws.ReceiveAsync(new ArraySegment<byte>(buffer), token);
                    if (result.MessageType == WebSocketMessageType.Close)
                    {
                        break;
                    }

                    var json = System.Text.Encoding.UTF8.GetString(buffer, 0, result.Count);
                    var msg = System.Text.Json.JsonSerializer.Deserialize<ChatApp.Frontend.Services.Message>(
                        json,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
                    );

                    if (msg != null && _activeLoadedRoomId == roomId)
                    {
                        if (!messages.Any(m => m.Id == msg.Id))
                        {
                            messages.Add(msg);
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                }
            }
            catch
            {
                // Retry if connection drops
            }

            isWsConnected = false;
            await InvokeAsync(StateHasChanged);

            if (token.IsCancellationRequested || _activeLoadedRoomId != roomId) break;
            await Task.Delay(2000, token).ContinueWith(_ => {});
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || string.IsNullOrEmpty(RoomId)) return;
        chatRateLimitAlert = null;
        var text = currentMessage;
        currentMessage = "";

        try
        {
            await ChatService.SendMessageAsync(RoomId, UserId ?? "user_1", Username ?? "user1", text);
        }
        catch (ChatApp.Frontend.Services.RateLimitException ex)
        {
            chatRateLimitAlert = ex.Message;
            currentMessage = text; // restore unsent text
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            chatRateLimitAlert = ex.Message;
            currentMessage = text;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private void ToggleCreateRoom()
    {
        isCreatingRoom = !isCreatingRoom;
        newRoomName = "";
    }

    private async Task HandleCreateKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateRoom();
        }
    }

    private async Task CreateRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoomName) || string.IsNullOrEmpty(UserId)) return;
        sidebarRateLimitAlert = null;

        try
        {
            var r = await ChatService.CreateRoomAsync(newRoomName, UserId);
            if (r != null)
            {
                newRoomName = "";
                isCreatingRoom = false;
                await LoadRooms(true);
                await SelectRoom(r.Id);
            }
        }
        catch (ChatApp.Frontend.Services.RateLimitException ex)
        {
            sidebarRateLimitAlert = ex.Message;
        }
        catch (Exception ex)
        {
            sidebarRateLimitAlert = ex.Message;
        }
    }

    private async Task HandleResetRateLimit()
    {
        await ChatService.ResetRateLimitAsync();
        sidebarRateLimitAlert = null;
        chatRateLimitAlert = null;
        await LoadRooms(true);
        if (!string.IsNullOrEmpty(RoomId))
        {
            await SwitchToRoom(RoomId);
        }
        await InvokeAsync(StateHasChanged);
    }

    private void Logout()
    {
        Navigation.NavigateTo("/", true);
    }

    private string FormatTimestamp(double ts)
    {
        try
        {
            if (ts <= 0) return "";
            var dt = DateTimeOffset.FromUnixTimeSeconds((long)ts).ToLocalTime();
            return dt.ToString("HH:mm");
        }
        catch
        {
            return "";
        }
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "U";
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private string GetRoomInitial(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "#";
        var parts = name.Split('#', ' ');
        var last = parts.LastOrDefault(p => !string.IsNullOrWhiteSpace(p));
        return last != null && last.Length <= 3 ? last : "#";
    }

    public async ValueTask DisposeAsync()
    {
        cts.Cancel();
        if (ws != null)
        {
            try
            {
                if (ws.State == WebSocketState.Open)
                {
                    await ws.CloseAsync(WebSocketCloseStatus.NormalClosure, "Leaving", CancellationToken.None);
                }
                ws.Dispose();
            }
            catch { }
        }
    }
}
