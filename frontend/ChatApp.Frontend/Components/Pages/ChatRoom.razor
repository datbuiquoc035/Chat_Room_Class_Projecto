@page "/lobby"
@page "/chat/{RoomId}"
@inject ChatApp.Frontend.Services.ChatService ChatService
@inject NavigationManager Navigation
@implements IAsyncDisposable
@using System.Net.WebSockets

<PageTitle>@(string.IsNullOrEmpty(RoomId) ? "Sảnh chờ" : (roomInfo?.Name ?? RoomId)) - NoSQL Chat Web</PageTitle>

<div class="wa-app-layout">
    <!-- LEFT COLUMN: SIDEBAR -->
    <div class="wa-sidebar">
        <!-- Sidebar Header -->
        <div class="wa-sidebar-header">
            <div class="wa-user-profile">
                <div class="wa-avatar wa-avatar-user">
                    @(GetInitials(Username))
                </div>
                <div class="wa-user-details">
                    <span class="wa-user-name">@Username</span>
                    <span class="wa-user-status">Trực tuyến</span>
                </div>
            </div>
            <div class="wa-header-actions">
                <button class="wa-icon-btn" title="Tạo phòng mới" @onclick="ToggleCreateRoom">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <button class="wa-icon-btn" title="Đăng xuất" @onclick="Logout">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                        <polyline points="16 17 21 12 16 7"></polyline>
                        <line x1="21" y1="12" x2="9" y2="12"></line>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Create Room Inline Box -->
        @if (isCreatingRoom)
        {
            <div class="wa-create-room-box">
                <div class="wa-create-header">
                    <span class="wa-create-title">Tạo phòng chat mới</span>
                    <button class="wa-close-btn" @onclick="ToggleCreateRoom">✕</button>
                </div>
                <div class="wa-create-inputs">
                    <input class="wa-sidebar-input" placeholder="Nhập tên phòng..." @bind="newRoomName" @bind:event="oninput" @onkeyup="HandleCreateKeyUp" />
                    <button class="btn-wa-primary wa-btn-sm" @onclick="CreateRoom">Tạo</button>
                </div>
            </div>
        }

        <!-- Search Bar -->
        <div class="wa-search-container">
            <div class="wa-search-bar">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#667781" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input class="wa-search-input" placeholder="Tìm kiếm phòng chat..." @bind="searchQuery" @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="wa-search-clear" @onclick="() => searchQuery = string.Empty">✕</button>
                }
            </div>
        </div>

        <!-- Sidebar Rate Limit Alert -->
        @if (!string.IsNullOrEmpty(sidebarRateLimitAlert))
        {
            <div class="wa-sidebar-alert">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <div class="wa-alert-content">
                    <span>@sidebarRateLimitAlert</span>
                    <button class="wa-reset-btn" @onclick="HandleResetRateLimit">Đặt lại</button>
                </div>
            </div>
        }

        <!-- Room List -->
        <div class="wa-room-list">
            @if (FilteredRooms.Count == 0)
            {
                <div class="wa-empty-rooms">
                    <span>Không tìm thấy phòng chat nào.</span>
                </div>
            }
            else
            {
                @foreach (var room in FilteredRooms)
                {
                    bool isActive = room.Id == RoomId;
                    <div class="wa-room-item @(isActive ? "active" : "")" @onclick="() => SelectRoom(room.Id)">
                        <div class="wa-avatar wa-avatar-room">
                            @(GetRoomInitial(room.Name))
                        </div>
                        <div class="wa-room-info">
                            <div class="wa-room-row">
                                <span class="wa-room-name">@room.Name</span>
                                <span class="wa-room-badge">@room.Id</span>
                            </div>
                            <div class="wa-room-row">
                                <span class="wa-room-sub">Tạo bởi: @room.Owner_Id</span>
                                <span class="wa-room-channel">chat:channel:@room.Id</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- RIGHT COLUMN: CHAT WINDOW OR SPLASH WELCOME SCREEN -->
    @if (string.IsNullOrEmpty(RoomId))
    {
        <!-- WhatsApp Splash Screen -->
        <div class="wa-splash-pane">
            <div class="wa-splash-content">
                <div class="wa-splash-art">
                    <svg width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="#D1D7DB" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                </div>
                <h2 class="wa-splash-title">NoSQL Chat Web</h2>
                <p class="wa-splash-description">
                    Hệ thống phòng chat thời gian thực xây dựng trên nền tảng <strong>Redis Pub/Sub</strong> và <strong>FastAPI</strong>, kết hợp phân hệ <strong>Middleware Rate Limiting</strong>.
                </p>
                <div class="wa-splash-instructions">
                    <span>Chọn một phòng chat từ danh sách bên trái hoặc bấm dấu <strong>+</strong> để tạo phòng mới.</span>
                </div>
                <div class="wa-splash-footer">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>Giới hạn tần suất 10 requests/phút bảo vệ chống DoS và Spam</span>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Active Chat Room Pane -->
        <div class="wa-chat-main">
            <!-- Chat Header -->
            <div class="wa-chat-header">
                <div class="wa-chat-room-meta">
                    <div class="wa-avatar wa-avatar-room">
                        @(GetRoomInitial(roomInfo?.Name))
                    </div>
                    <div class="wa-chat-title-group">
                        <span class="wa-chat-title">@(roomInfo?.Name ?? "Phòng Chat " + RoomId)</span>
                        <span class="wa-chat-meta-sub">
                            Mã: <code>@RoomId</code> &bull; Kênh: <code>chat:channel:@RoomId</code>
                        </span>
                    </div>
                </div>

                <div class="wa-chat-header-right">
                    <div class="wa-status-pill @(isWsConnected ? "online" : "offline")">
                        <span class="wa-status-dot"></span>
                        <span>@(isWsConnected ? "Pub/Sub Trực Tuyến" : "Đang kết nối lại...")</span>
                    </div>
                    <button class="wa-icon-btn" title="Đóng phòng chat" @onclick="CloseRoom">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Messages Stream Area -->
            <div class="wa-messages-container wa-chat-pattern" id="messagesContainer">
                <div class="wa-chat-intro-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    <span>Lưu trữ 100 tin nhắn gần nhất qua Redis LIST và truyền tin tức thời qua Redis Pub/Sub</span>
                </div>

                @if (isLoadingRoom)
                {
                    <div class="text-center my-4 text-muted small">
                        <span>Đang tải tin nhắn phòng...</span>
                    </div>
                }
                else
                {
                    @foreach (var msg in messages)
                    {
                        if (msg.User_Id == "system")
                        {
                            <div class="wa-system-message">
                                <span class="wa-system-pill">@msg.Content</span>
                            </div>
                        }
                        else
                        {
                            bool isMe = msg.User_Id == UserId;
                            <div class="wa-message-row @(isMe ? "outgoing" : "incoming")">
                                <div class="wa-bubble @(isMe ? "wa-bubble-out" : "wa-bubble-in")">
                                    @if (!isMe)
                                    {
                                        <div class="wa-bubble-sender">@msg.Username</div>
                                    }
                                    <div class="wa-bubble-content">@msg.Content</div>
                                    <div class="wa-bubble-meta">
                                        <span class="wa-bubble-time">@FormatTimestamp(msg.Timestamp)</span>
                                        @if (isMe)
                                        {
                                            <svg class="wa-checkmarks" width="16" height="11" viewBox="0 0 16 11" fill="none">
                                                <path d="M11.0001 0.5L4.50012 7L1.50012 4" stroke="#53BDEB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M14.5001 0.5L8.00012 7L6.50012 5.5" stroke="#53BDEB" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!-- Rate Limit Alert Banner -->
            @if (!string.IsNullOrEmpty(chatRateLimitAlert))
            {
                <div class="wa-rate-alert-bar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                    <span><strong>Chặn Rate Limiter (HTTP 429):</strong> @chatRateLimitAlert</span>
                    <button class="wa-reset-btn" @onclick="HandleResetRateLimit">Đặt lại</button>
                    <button class="wa-alert-close" @onclick="() => chatRateLimitAlert = null">✕</button>
                </div>
            }

            <!-- Chat Input Footer -->
            <div class="wa-chat-footer">
                <div class="wa-input-wrapper">
                    <input class="wa-chat-input"
                           placeholder="Nhập tin nhắn..."
                           @bind="currentMessage"
                           @bind:event="oninput"
                           @onkeyup="HandleKeyUp" />
                </div>
                <button class="btn-wa-primary wa-btn-send" @onclick="SendMessage" title="Gửi tin nhắn (Enter)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
        </div>
    }
</div>

<style>
/* Sidebar Styles */
.wa-sidebar {
    width: 380px;
    min-width: 380px;
    max-width: 380px;
    height: 100vh;
    background-color: var(--color-panel);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
}

.wa-sidebar-header {
    height: 60px;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.wa-user-profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.wa-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 0.875rem;
}

.wa-avatar-user {
    background-color: #00A884;
    color: #FFFFFF;
}

.wa-avatar-room {
    background-color: #EDF3EC;
    color: #346538;
    border: 1px solid rgba(52, 101, 56, 0.15);
}

.wa-user-details {
    display: flex;
    flex-direction: column;
}

.wa-user-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-charcoal);
}

.wa-user-status {
    font-size: 0.75rem;
    color: var(--color-wa-green);
}

.wa-header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.wa-icon-btn {
    background: transparent;
    border: none;
    color: var(--color-muted);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.wa-icon-btn:hover {
    background-color: rgba(0, 0, 0, 0.05);
    color: var(--color-charcoal);
}

.wa-create-room-box {
    background: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 1rem;
    animation: fadeIn 0.2s ease;
}

.wa-create-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.wa-create-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-charcoal);
}

.wa-close-btn {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.875rem;
}

.wa-create-inputs {
    display: flex;
    gap: 0.5rem;
}

.wa-sidebar-input {
    flex: 1;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.875rem;
    outline: none;
}

.wa-sidebar-input:focus {
    border-color: var(--color-wa-green);
}

.wa-btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.8125rem;
}

.wa-search-container {
    padding: 0.5rem 0.75rem;
    background-color: var(--color-panel);
    border-bottom: 1px solid var(--color-border);
}

.wa-search-bar {
    background-color: var(--color-canvas);
    border-radius: 8px;
    display: flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    gap: 0.5rem;
}

.wa-search-input {
    border: none;
    background: transparent;
    font-size: 0.875rem;
    color: var(--color-charcoal);
    width: 100%;
    outline: none;
}

.wa-search-clear {
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.875rem;
}

.wa-sidebar-alert {
    background-color: var(--color-pale-red);
    color: var(--color-pale-red-text);
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid rgba(159, 47, 45, 0.2);
}

.wa-alert-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.5rem;
}

.wa-reset-btn {
    background-color: #FFFFFF;
    border: 1px solid rgba(159, 47, 45, 0.3);
    color: var(--color-pale-red-text);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
}

.wa-room-list {
    flex: 1;
    overflow-y: auto;
}

.wa-room-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    transition: background-color 0.1s ease;
    user-select: none;
}

.wa-room-item:hover {
    background-color: #F5F6F6;
}

.wa-room-item.active {
    background-color: var(--color-canvas);
    border-left: 3px solid var(--color-wa-green);
}

.wa-room-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.wa-room-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.wa-room-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-charcoal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wa-room-badge {
    font-size: 0.6875rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
}

.wa-room-sub {
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wa-room-channel {
    font-size: 0.6875rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
}

.wa-empty-rooms {
    padding: 2rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.875rem;
}

/* Splash Pane */
.wa-splash-pane {
    flex: 1;
    height: 100vh;
    background-color: #F0F2F5;
    border-bottom: 6px solid var(--color-wa-green);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
}

.wa-splash-content {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.wa-splash-art {
    margin-bottom: 1.5rem;
}

.wa-splash-title {
    font-size: 1.75rem;
    font-weight: 300;
    color: var(--color-charcoal);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
}

.wa-splash-description {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
}

.wa-splash-instructions {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.75rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-charcoal);
    margin-bottom: 2.5rem;
}

.wa-splash-footer {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--color-muted);
}

/* Chat Main Pane */
.wa-chat-main {
    flex: 1;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #EFEAE2;
    min-width: 0;
}

.wa-chat-header {
    height: 60px;
    background-color: var(--color-canvas);
    border-bottom: 1px solid var(--color-border);
    padding: 0 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 2;
}

.wa-chat-room-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
}

.wa-chat-title-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.wa-chat-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-charcoal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.wa-chat-meta-sub {
    font-size: 0.75rem;
    color: var(--color-muted);
}

.wa-chat-header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.wa-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: #FFFFFF;
}

.wa-status-pill.online {
    color: #346538;
}

.wa-status-pill.online .wa-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #25D366;
}

.wa-status-pill.offline {
    color: #956400;
}

.wa-status-pill.offline .wa-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #E5A800;
}

.wa-messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.wa-chat-intro-pill {
    align-self: center;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.4rem 0.85rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    box-shadow: 0 1px 1px rgba(0,0,0,0.03);
}

.wa-system-message {
    align-self: center;
    margin: 0.25rem 0;
}

.wa-system-pill {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    color: var(--color-muted);
}

.wa-message-row {
    display: flex;
    width: 100%;
}

.wa-message-row.outgoing {
    justify-content: flex-end;
}

.wa-message-row.incoming {
    justify-content: flex-start;
}

.wa-bubble {
    max-width: 65%;
    min-width: 120px;
    padding: 0.45rem 0.75rem 0.35rem 0.75rem;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
    position: relative;
    word-break: break-word;
}

.wa-bubble-out {
    background-color: var(--color-wa-bubble-out);
    color: var(--color-charcoal);
